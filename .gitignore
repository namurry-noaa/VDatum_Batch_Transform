# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Environments
.venv/
env/
venv/

# Generated outputs (do not commit result files) — but SHIP the empty dir
# with its README so users don't have to create it.
output/*
!output/README.md
output_*/

# Real working data (the PJH use-case sheets) stays LOCAL — not committed.
# Small curated example inputs live in examples/ and ARE committed.
# SHIP the empty data/ dir with its README (contents otherwise ignored).
data/*
!data/README.md

# OS / editor cruft
.DS_Store
*~
.vscode/

# Legacy local session log format (superseded by the tracked
# <project>_summary.md, which IS committed).
*_summary.claude
